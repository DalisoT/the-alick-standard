# Copy to .env.local — never commit secrets

# Database
#   Local dev  → file:./data/tas.db
#   Turso prod → libsql://your-db-name.turso.io  (+ DATABASE_AUTH_TOKEN below)
# The libsql client is the same driver for both — switch the URL and the app runs unchanged.
DATABASE_URL=file:./data/tas.db
DATABASE_AUTH_TOKEN=

# ─── Barbero multi-tenant platform ─────────────────────────────────
# The platform's own domain. Each tenant lives at <slug>.${NEXT_PUBLIC_PLATFORM_DOMAIN}
# In production this will be barbero.co.zm (registered later). For now we use
# barbero.local so the codebase compiles and works on Vercel preview URLs.
NEXT_PUBLIC_PLATFORM_DOMAIN=barbero.local

# Public URL used for OG tags and PWA install hints (set this to your deploy URL)
NEXT_PUBLIC_SITE_URL=https://thealickstandard.example.com

# Auth secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-this-with-a-32-byte-hex-string-from-crypto-randomBytes

# Initial admin credentials (used only on first DB seed, which runs automatically on first boot)
ADMIN_USERNAME=alick
ADMIN_PASSWORD=standard2026

# Public brand config (optional override)
NEXT_PUBLIC_BUSINESS_NAME="THE ALICK STANDARD"
NEXT_PUBLIC_WHATSAPP_NUMBER=260977000000

# Stripe (Week 3) — leave empty until you wire billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# Resend (transactional email) — Week 2
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hello@barbero.local